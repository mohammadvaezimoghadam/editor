# ==========================================
# Wagtail AI Environment Configuration
# ==========================================

# پورت باز سرور (اگر ۸۰ اشغال بود می‌توانید ۸۰۸۰ یا ۸۰۰۰ بگذارید)
PORT=80

# تنظیمات پایه جنگو
DJANGO_DEBUG=false
SECRET_KEY=generate-a-secure-random-secret-key-for-production-here
ALLOWED_HOSTS=*

# مشخصات ادمین اولیه (در اجرای اول داکر به صورت خودکار ساخته می‌شود)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=changeme123
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ------------------------------------------
# AI Provider Configuration (Default: Groq)
# ------------------------------------------
# برای استفاده از Groq (سریع و بدون تحریم در ایران):
OPENAI_API_KEY=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
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b

# برای استفاده از دیتابیس خارجی مثل PostgreSQL (اختیاری - پیش‌فرض SQLite است):
# DATABASE_URL=postgres://user:password@db-host:5432/wagtail_db
